[Unit]
Description=contrata o planta .cl — FastAPI
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=contrata
WorkingDirectory=/opt/contrataoplanta
EnvironmentFile=/opt/contrataoplanta/.env
ExecStart=/opt/contrataoplanta/venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=contrataoplanta-api

# Seguridad
NoNewPrivileges=true
PrivateTmp=true
# Sandboxing adicional (systemd). El proceso sólo necesita leer su código,
# hablar con Postgres por red y escribir logs vía journal — nada más.
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
# ProtectSystem=strict deja todo / en read-only. La app escribe logs de
# procesos admin en /opt/contrataoplanta/logs; habilitamos sólo ese subárbol.
ReadWritePaths=/opt/contrataoplanta/logs

[Install]
WantedBy=multi-user.target
