# Normaliza el fin de línea: el repositorio guarda LF para todo el texto.
# El proyecto se despliega en Linux (Railway, VPS con systemd, Cloudflare),
# así que LF es lo correcto y evita que git marque medio repo como modificado
# por diferencias CRLF/LF en Windows.
* text=auto eol=lf

# Scripts y configs que DEBEN ser LF sí o sí (se ejecutan en Linux)
*.sh         text eol=lf
*.service    text eol=lf
*.timer      text eol=lf
*.conf       text eol=lf
*.mako       text eol=lf

# Código y configuración de texto -> LF
*.py         text eol=lf
*.js         text eol=lf
*.css        text eol=lf
*.html       text eol=lf
*.json       text eol=lf
*.sql        text eol=lf
*.md         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.toml       text eol=lf
*.ini        text eol=lf
*.txt        text eol=lf
*.xml        text eol=lf
*.svg        text eol=lf
*.webmanifest text eol=lf
.env.example text eol=lf

# Binarios: git no debe convertirlos ni intentar diffearlos
*.png        binary
*.ico        binary
*.woff2      binary
*.pptx       binary
*.xlsx       binary
*.pdf        binary
