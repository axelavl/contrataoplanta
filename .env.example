DB_HOST=localhost
DB_PORT=5432
DB_NAME=empleospublicos
DB_USER=postgres
# Obligatorio — sin valor por defecto. La API aborta si falta.
DB_PASSWORD=change_me

SITE_URL=https://contrataoplanta.cl

# Autenticación del panel admin. Obligatorios — la API aborta si faltan.
# Genera un valor fuerte (ej: `openssl rand -hex 24`).
ADMIN_PASSWORD=
# Secret para firmar los JWT de admin (HS256). Obligatorio. Rotarlo
# invalida todas las sesiones activas. Genera con `openssl rand -hex 32`.
ADMIN_JWT_SECRET=
# Tiempo de vida de cada JWT de admin en segundos. Default 12h.
ADMIN_JWT_TTL_SEG=43200
# Prefijo secreto para las rutas /api/<ADMIN_PATH>/... (ej: ADMIN_PATH=f8a3d2e7).
# Si no se define, cae a "_gestion_ops" (valor público, solo útil en dev).
ADMIN_PATH=

# Opcional: lista CSV de orígenes permitidos para CORS.
# CORS_ALLOW_ORIGINS=https://contrataoplanta.cl,https://estadoemplea.pages.dev

RESEND_API_KEY=
EMAIL_FROM=alertas@estadoemplea.pages.dev

MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=

# Analítica (opcional). UMAMI_SCRIPT_URL + UMAMI_WEBSITE_ID activan el tracking
# externo de Umami en el frontend. Las UMAMI_API_* habilitan que el panel admin
# («Estadísticas del sitio») consulte la API de Umami y muestre sus métricas.
# La analítica PROPIA (tabla web_eventos) funciona sin nada de esto.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
UMAMI_API_URL=
# Usa UMAMI_API_KEY (Umami Cloud) o UMAMI_USERNAME + UMAMI_PASSWORD (self-hosted).
UMAMI_API_KEY=
UMAMI_USERNAME=
UMAMI_PASSWORD=

# Opcional: proxy de salida para scrapers FF.AA./policía (WAF/geobloqueo por IP).
# Si se define, esos scrapers enrutan su tráfico por aquí; el resto sale directo.
# Formato: http://usuario:password@host:puerto  (ej. zona Residential de Bright Data)
PROXY_CL=
