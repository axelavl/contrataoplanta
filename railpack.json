{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "...",
        "PLAYWRIGHT_BROWSERS_PATH=/app/.ms-playwright python -m playwright install chromium"
      ]
    }
  },
  "deploy": {
    "variables": {
      "PLAYWRIGHT_BROWSERS_PATH": "/app/.ms-playwright"
    },
    "aptPackages": [
      "tesseract-ocr",
      "tesseract-ocr-spa",
      "libnss3",
      "libnspr4",
      "libatk1.0-0",
      "libatk-bridge2.0-0",
      "libcups2",
      "libdrm2",
      "libxkbcommon0",
      "libxcomposite1",
      "libxdamage1",
      "libxfixes3",
      "libxrandr2",
      "libgbm1",
      "libasound2",
      "libpango-1.0-0",
      "libcairo2",
      "libatspi2.0-0",
      "tesseract-ocr",
      "tesseract-ocr-spa"
    ]
  }
}
